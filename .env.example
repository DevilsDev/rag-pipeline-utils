# Example environment for docker-compose.yml
#
# Copy to .env (which is git- and docker-ignored) and set strong, unique
# values. The required variables are deliberately left empty here so that
# `docker compose` refuses to start until they are filled in.
#
# Generate a value with, for example:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use URL-safe characters (hex is fine): POSTGRES_PASSWORD and REDIS_PASSWORD
# are embedded in connection URLs.

# --- Required -------------------------------------------------------------

# Password for the "raguser" PostgreSQL role (database "ragdb").
POSTGRES_PASSWORD=

# Password for Redis (passed to redis-server --requirepass).
REDIS_PASSWORD=

# Password for the Grafana admin account.
GRAFANA_ADMIN_PASSWORD=

# --- Optional -------------------------------------------------------------

# Grafana admin user name (default: admin).
# GRAFANA_ADMIN_USER=admin

# Provider API keys used by the rag-pipeline service (may be left empty).
OPENAI_API_KEY=
PINECONE_API_KEY=
