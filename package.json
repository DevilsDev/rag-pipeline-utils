{
  "name": "@devilsdev/rag-pipeline-utils",
  "version": "2.7.0",
  "description": "Composable retrieval-augmented generation (RAG) for Node.js: grounded citations, evaluation, guardrails, hybrid retrieval and a CLI.",
  "main": "dist/index.cjs",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "experimental": [
        "dist/experimental.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "require": "./dist/experimental.cjs",
      "import": "./dist/experimental.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.cjs",
      "import": "./dist/testing.mjs"
    },
    "./cli": "./bin/cli.js"
  },
  "bin": {
    "rag-pipeline": "./bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js && node scripts/generate-types.js && node scripts/check-type-exports.js",
    "prepack": "npm run build",
    "docs:validate": "node scripts/validate-docs-examples.js",
    "verify:esm": "node scripts/verify-esm.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run docs:validate && npm run verify:esm",
    "guard:cjs": "node scripts/guard-cjs.js",
    "pretest": "npm run guard:cjs && node scripts/setup.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --maxWorkers=50% --config jest.config.js",
    "test:serial": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config jest.config.js",
    "test:ci": "jest --coverage",
    "test:open-handles": "jest --detectOpenHandles --runInBand",
    "test:report": "node scripts/test-reporter.js",
    "posttest": "node scripts/generate-test-reports.js",
    "format": "prettier --write --ignore-unknown \"{__tests__,scripts,bin,docs-site,examples,contracts}/**/*.{js,jsx,ts,tsx,mjs,cjs}\" \"*.{js,mjs,cjs}\" \"**/*.{json,md,mdx,yml,yaml,css,scss,html}\"",
    "format:check": "prettier --check --ignore-unknown \"{__tests__,scripts,bin,docs-site,examples,contracts}/**/*.{js,jsx,ts,tsx,mjs,cjs}\" \"*.{js,mjs,cjs}\" \"**/*.{json,md,mdx,yml,yaml,css,scss,html}\"",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .js --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js,.jsx --ignore-path .gitignore --fix",
    "lint:strict": "eslint . --ext .js,.jsx --ignore-path .gitignore --max-warnings 0",
    "lint:errors-only": "eslint . --ext .js,.jsx --ignore-path .gitignore --quiet",
    "lint:diagnostic": "eslint . --ext .js,.jsx --ignore-path .gitignore --format=stylish",
    "lint:strict:ts": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:diagnostic:ts": "eslint . --ext .js,.jsx,.ts,.tsx --format=stylish",
    "lint:errors-only:ts": "eslint . --ext .js,.jsx,.ts,.tsx --quiet",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "verify:mocks": "node scripts/verify-fixture-mocks.js",
    "build:docs": "npm run docs:build",
    "ci": "node scripts/ci-runner.js",
    "docs:dev": "cd docs-site && npm run start",
    "docs:version": "npx docusaurus docs:version",
    "watch:lqip": "node docs-site/scripts/watch-images.js",
    "docs:clear": "docusaurus clear --site-dir docs-site",
    "docs:start": "cd docs-site && npm run start",
    "docs:build": "cd docs-site && npm run build",
    "docs:serve": "docusaurus serve docs-site",
    "docs:deploy": "node docs-site/scripts/sync-changelog.js && docusaurus deploy docs-site",
    "roadmap:close": "node scripts/close-done-roadmap-issues.js",
    "labels:sync": "node scripts/ensure-roadmap-labels.js",
    "release:tag": "node scripts/generate-release-note.js v$(node -p \"require('./package.json').version\")",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:critical": "npm audit --audit-level=critical --production || echo 'Development vulnerabilities found but acceptable'",
    "security:audit:json": "npm audit --json > security-audit-report.json || true",
    "docs:generate": "node scripts/generate-docs.js --verbose",
    "docs:api": "npm run build && typedoc && prettier --write docs-site/docs/api --log-level warn",
    "benchmark": "node scripts/benchmark.js --iterations=100 --verbose",
    "benchmark:quick": "node scripts/benchmark.js --iterations=20",
    "benchmark:full": "node scripts/benchmark.js --iterations=500 --verbose",
    "bench:speed": "node benchmarks/speed.js",
    "bench:quality": "node benchmarks/quality.js",
    "dev": "node scripts/dev-tools.js menu",
    "dev:health": "node scripts/dev-tools.js health",
    "dev:setup": "node scripts/dev-tools.js setup",
    "dev:clean": "node scripts/dev-tools.js clean",
    "dev:update": "node scripts/dev-tools.js update",
    "dev:report": "node scripts/dev-tools.js report",
    "security:fix": "npm audit fix",
    "security:fix:force": "npm audit fix --force",
    "security:check": "npm audit --production && echo 'Production security check passed'",
    "security:report": "npm run security:audit:json && echo 'Security report generated: security-audit-report.json'",
    "ci:audit": "node scripts/audit/gha-audit.js",
    "ci:test-workflows": "node scripts/ci/test-workflows.js",
    "tests:categorize": "node scripts/test-categorizer.js",
    "tests:affected": "node scripts/run-affected.js",
    "tests:full": "jest --runInBand --reporters=default --json --outputFile=test-results-current.json",
    "tests:ci": "jest --maxWorkers=50% --reporters=default --json --outputFile=test-results-current.json",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:simple": "jest --maxWorkers=1 --no-coverage",
    "verify:pack": "node scripts/verify-npm-pack.js",
    "smoke:pack": "node scripts/smoke-test-pack.js",
    "demo:record": "vhs assets/demo.tape",
    "verify": "npm run lint && npm run typecheck --if-present && npm test",
    "sbom": "node scripts/generate-sbom.js",
    "observability:setup": "node scripts/setup-observability.js",
    "observability:start": "cd observability && ./scripts/start.sh",
    "observability:stop": "cd observability && ./scripts/stop.sh",
    "telemetry:init": "node -e \"require('./src/observability/telemetry').initializeTelemetry()\"",
    "security:monitor": "node -e \"require('./src/observability/security-monitor').initializeSecurityMonitoring()\"",
    "audit:compliance": "node -e \"require('./src/observability/audit-logger').initializeAuditLogging()\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevilsDev/rag-pipeline-utils.git"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "llm",
    "embeddings",
    "vector-search",
    "semantic-search",
    "pipeline",
    "chunking",
    "agentic",
    "graphrag",
    "guardrails",
    "evaluation",
    "citation",
    "openai",
    "anthropic",
    "cohere",
    "ollama",
    "ai",
    "nodejs",
    "typescript",
    "cli"
  ],
  "author": "Ali Kahwaji",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DevilsDev/rag-pipeline-utils/issues"
  },
  "homepage": "https://github.com/DevilsDev/rag-pipeline-utils#readme",
  "files": [
    "dist/",
    "src/",
    "!src/mocks/",
    "!src/dev/examples/",
    "!src/dev/README.md",
    "!src/utils/examples/",
    "!src/utils/ci/",
    "!src/ci/",
    "!src/scripts/",
    "bin/",
    "contracts/",
    ".ragrc.schema.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "BENCHMARKS.md",
    "SEMVER.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": "eslint --fix",
    "{__tests__,scripts,bin,docs-site,examples,contracts}/**/*.{js,jsx,ts,tsx,mjs,cjs}": "prettier --write --ignore-unknown",
    "*.{js,mjs,cjs}": "prettier --write --ignore-unknown",
    "**/*.{json,md,mdx,yml,yaml,css,scss,html}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@octokit/rest": "^21.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/exporter-jaeger": "^1.26.0",
    "@opentelemetry/exporter-prometheus": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-metrics": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-base": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.14.1",
    "acorn": "8.15.0",
    "ai": "6.0.317",
    "ai-v7": "npm:ai@7.0.156",
    "babel-jest": "^29.7.0",
    "cross-env": "7.0.3",
    "docusaurus-plugin-llms": "0.6.1",
    "esbuild": "^0.25.2",
    "eslint": "^8.57.1",
    "eslint-plugin-storybook": "^0.12.0",
    "framer-motion": "^12.7.4",
    "husky": "^8.0.3",
    "hyparquet": "1.32.0",
    "isolated-vm": "5.0.4",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^15.5.1",
    "octokit": "^4.1.3",
    "pg": "8.23.1",
    "plaiceholder": "^3.0.0",
    "prettier": "^3.5.3",
    "prop-types": "^15.8.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.1",
    "ts-jest": "^29.3.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "5.8.3",
    "why-is-node-running": "^3.2.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "2.1.1",
    "axios": "^1.21.0",
    "chalk": "4.1.2",
    "chokidar": "^4.0.3",
    "cli-table3": "0.6.5",
    "commander": "^13.1.0",
    "csv-parse": "^5.6.0",
    "fast-glob": "^3.3.3",
    "inquirer": "^8.2.5",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "9.0.2",
    "marked": "15.0.12",
    "openai": "^4.93.0",
    "ora": "5.4.1",
    "pino": "^9.6.0"
  },
  "peerDependencies": {
    "isolated-vm": ">=5.0.0",
    "pg": ">=8.11.0",
    "pino-pretty": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "isolated-vm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.2",
    "form-data": "^4.0.6",
    "ws@^8.0.0": "^8.21.0",
    "zod": "^4.6.7"
  }
}
