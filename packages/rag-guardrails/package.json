{
  "name": "@devilsdev/rag-guardrails",
  "version": "3.2.0",
  "description": "Guardrails for RAG: prompt-injection detection and pre-retrieval, retrieval and post-generation guards.",
  "keywords": [
    "rag",
    "guardrails",
    "prompt-injection",
    "llm-security"
  ],
  "license": "MIT",
  "author": "Ali Kahwaji",
  "homepage": "https://devilsdev.github.io/rag-pipeline-utils/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevilsDev/rag-pipeline-utils.git"
  },
  "bugs": {
    "url": "https://github.com/DevilsDev/rag-pipeline-utils/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@devilsdev/rag-core": "3.2.0"
  }
}
